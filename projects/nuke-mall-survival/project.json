  "captions": [
    {
      "start": 0.25,
      "end": 4.81,
      "text": "You are in the middle of a shopping mall when emergency sirens scream."
    },
    {
      "start": 4.96,
      "end": 8.44,
      "text": "A nuclear detonation in under sixty seconds."
    },
    {
      "start": 8.59,
      "end": 12.51,
      "text": "Most people run to the parking lot and get incinerated in traffic."
    },
    {
      "start": 12.66,
      "end": 16.9,
      "text": "Your actual survival ticket? Run downward."
    },
    {
      "start": 17.05,
      "end": 22.81,
      "text": "A modern mall basement is reinforced with thousands of tons of concrete and earth,"
    },
    {
      "start": 22.96,
      "end": 26.24,
      "text": "creating an impromptu radiation fortress."
    },
    {
      "start": 26.39,
      "end": 31.47,
      "text": "The instant the flash hits: drop flat against an interior support pillar,"
    },
    {
      "start": 31.62,
      "end": 35.38,
      "text": "face down, hands over your head, and open your mouth."
    },
    {
      "start": 35.53,
      "end": 41.29,
      "text": "Keeping your mouth open equalizes blast overpressure, saving your lungs and eardrums."
    },
    {
      "start": 41.44,
      "end": 46.28,
      "text": "You survived the shockwave. But the real countdown has just begun."
    }
  ],
