  "captions": [
    {
      "start": 0.25,
      "end": 2.752,
      "text": "I turned around in the dark."
    },
    {
      "start": 2.752,
      "end": 5.81,
      "text": "But standing behind me was not a monster."
    },
    {
      "start": 5.96,
      "end": 10.92,
      "text": "It was ME from tomorrow, clutching an iron crowbar."
    },
    {
      "start": 11.07,
      "end": 15.31,
      "text": "He whispered: The government never dropped a bomb."
    },
    {
      "start": 15.31,
      "end": 19.55,
      "text": "They tried to burn the rift beneath this mall."
    },
    {
      "start": 19.7,
      "end": 22.388,
      "text": "Suddenly, the floor shattered!"
    },
    {
      "start": 22.388,
      "end": 27.38,
      "text": "Massive purple rift tendrils erupted from below!"
    },
    {
      "start": 27.53,
      "end": 29.87,
      "text": "The bunker was collapsing."
    },
    {
      "start": 29.87,
      "end": 33.381,
      "text": "He shouted: Head for the maintenance shaft! Close the loop!"
    },
    {
      "start": 33.531,
      "end": 37.611,
      "text": "I leaped toward the ladder into the blinding daylight,"
    },
    {
      "start": 37.761,
      "end": 42.401,
      "text": "just as he slammed the heavy blast door shut forever."
    },
    {
      "start": 42.551,
      "end": 45.543,
      "text": "I stumbled onto the quiet street above."
    },
    {
      "start": 45.543,
      "end": 47.991,
      "text": "My phone buzzed one last time:"
    },
    {
      "start": 48.141,
      "end": 51.632,
      "text": "Timeline secured. You survived."
    }
  ],
