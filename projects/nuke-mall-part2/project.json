  "captions": [
    {
      "start": 0.25,
      "end": 3.93,
      "text": "The blast shook the basement, but I was alive."
    },
    {
      "start": 4.08,
      "end": 6.68,
      "text": "Then my phone buzzed in the dark."
    },
    {
      "start": 6.83,
      "end": 10.51,
      "text": "A notification from ME, twenty-four hours from now."
    },
    {
      "start": 10.66,
      "end": 13.26,
      "text": "Do not drink the mall water."
    },
    {
      "start": 13.26,
      "end": 15.66,
      "text": "The blast was a distraction."
    },
    {
      "start": 15.81,
      "end": 20.77,
      "text": "I looked up. Glowing black spores were pouring from the vents."
    },
    {
      "start": 20.92,
      "end": 22.774,
      "text": "The screen flickered:"
    },
    {
      "start": 22.774,
      "end": 25.8,
      "text": "They did not drop a bomb. They opened a rift."
    },
    {
      "start": 25.95,
      "end": 30.71,
      "text": "From the emergency stairwell, heavy metallic footsteps echoed."
    },
    {
      "start": 30.86,
      "end": 33.682,
      "text": "The blast doors did not seal them out."
    },
    {
      "start": 33.682,
      "end": 36.74,
      "text": "They locked you in with them."
    },
    {
      "start": 36.89,
      "end": 38.65,
      "text": "Final message: Look behind you."
    }
  ],
