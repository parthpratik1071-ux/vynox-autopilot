  "captions": [
    {
      "start": 0.25,
      "end": 2.458,
      "text": "That is when I realized,"
    },
    {
      "start": 2.458,
      "end": 5.77,
      "text": "my phone was sending messages from the future."
    },
    {
      "start": 5.92,
      "end": 8.6,
      "text": "Do not leave the house at 7:30."
    },
    {
      "start": 8.6,
      "end": 11.28,
      "text": "The clock said 7:27."
    },
    {
      "start": 11.43,
      "end": 14.15,
      "text": "Then: you have two minutes."
    },
    {
      "start": 14.3,
      "end": 17.666,
      "text": "Outside, everything looked normal."
    },
    {
      "start": 17.666,
      "end": 21.78,
      "text": "Then the phone vibrated: Look behind you."
    },
    {
      "start": 21.93,
      "end": 26.635,
      "text": "Silence. Nobody was there. I typed: Who are you?"
    },
    {
      "start": 26.635,
      "end": 31.341,
      "text": "Before I could send it, a reply appeared: You."
    },
    {
      "start": 31.491,
      "end": 34.119,
      "text": "A video file popped up in the chat,"
    },
    {
      "start": 34.119,
      "end": 37.331,
      "text": "timestamped tomorrow at 7:30 PM."
    },
    {
      "start": 37.481,
      "end": 39.713,
      "text": "I watched myself enter the room,"
    },
    {
      "start": 39.713,
      "end": 42.441,
      "text": "and stare straight into the camera."
    },
    {
      "start": 42.591,
      "end": 44.479,
      "text": "If you are watching this,"
    },
    {
      "start": 44.479,
      "end": 47.311,
      "text": "you have already made the wrong choice."
    }
  ],
